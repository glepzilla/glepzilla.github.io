---
import TerminalLayout from '../layouts/TerminalLayout.astro';
import { banner } from '../lib/banner';
import { PROJECTS } from '../lib/site';

const heading = banner('projects');
---
<TerminalLayout
  title="Проекты — glepzilla"
  description="Проекты Глеба: боты, сайты, домашний сервер и всё, что растёт рядом."
  quietBackground
>
  <header class="tm-section page-head" data-reveal>
    <h1 class="tm-banner"><span class="tm-sr">Проекты</span><span aria-hidden="true">{heading}</span></h1>
    <p class="tm-lede">Всё, что живёт на домашнем сервере и в репозиториях. Что-то доведено до конца, что-то растёт по выходным.</p>
  </header>

  <section class="tm-section listing" data-reveal>
    <div class="tm-prompt prompt"><span class="tm-prompt-sign">%</span> ls -l ~/projects</div>
    <div class="tm-out count">total {PROJECTS.length}</div>

    <div class="grid">
      {PROJECTS.map((project) => {
        const Card = project.href ? 'a' : 'article';
        return (
          <Card
            class="tm-project card"
            href={project.href}
            target={project.external ? '_blank' : undefined}
            rel={project.external ? 'noopener noreferrer' : undefined}
          >
            <span class="card-top">
              <span class="tm-project-num">{project.num}</span>
              <span class="tm-label">{project.year} · {project.status}</span>
            </span>
            <span class="tm-project-name">{project.name}</span>
            <span class="tm-project-desc">{project.long}</span>

            <span class="tags">
              {project.tags.map((tag) => <span class="tm-tag">{tag}</span>)}
            </span>

            <span class="card-bottom">
              {project.repo
                ? <span class="repo"><em>repo:</em> {project.repo}</span>
                : <span class="repo"><em>repo:</em> локально</span>}
              {project.href && <span class="tm-link go">открыть →</span>}
            </span>
          </Card>
        );
      })}
    </div>

    <a class="archive" href="/blog/">
      <span class="tm-label">Лаборатория</span>
      <span class="archive-title">Записки на полях →</span>
      <span class="archive-desc">Короткие тексты о том, что получилось и что нет, между большими проектами.</span>
    </a>
  </section>
</TerminalLayout>

<style>
  .page-head { padding-block: 60px 0; }
  .listing { padding-block: 34px 48px; }

  .prompt { font-size: 13.5px; }
  .count { padding-bottom: 18px; }

  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .card { gap: 14px; padding: 30px; }
  .card-top { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }

  .tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: auto; padding-top: 4px; }

  .card-bottom {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--tm-line-soft);
    color: var(--tm-faint);
    font-size: 12px;
  }
  .repo em { color: var(--tm-green-deep); font-style: normal; }
  .go { flex: none; font-size: 12.5px; }
  a.card:hover .go { color: var(--tm-green-bright); }

  .archive {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 20px;
    padding: 30px;
    border: 1px solid var(--tm-line);
    border-radius: 10px;
    background: rgba(20, 24, 19, 0.45);
    transition: border-color var(--tm-motion-fast) ease, background var(--tm-motion-fast) ease;
  }
  .archive:hover { border-color: rgba(143, 187, 95, 0.45); background: rgba(38, 51, 27, 0.5); }
  .archive-title {
    color: var(--tm-text);
    font-family: var(--tm-font-display);
    font-size: 22px;
    line-height: 1.25;
  }
  .archive-desc {
    max-width: 60ch;
    color: var(--tm-muted);
    font-family: var(--tm-font-read);
    font-size: 15.5px;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 700px) {
    .page-head { padding-block: 38px 0; }
    .listing { padding-block: 26px 34px; }
    .card, .archive { padding: 24px; }
  }
</style>
