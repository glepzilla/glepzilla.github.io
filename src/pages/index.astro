---
// Homepage — Claude Design "Glepzilla Terminal", artboard 2a (figlet wordmark
// + live aurora background). The window chrome, nav and footer live in
// TerminalLayout; this page owns the hero, the ls-card and the project row.
import { getCollection } from 'astro:content';
import TerminalLayout from '../layouts/TerminalLayout.astro';
import { FRAMES } from '../lib/wordmark';
import { FEATURED_PROJECTS } from '../lib/site';
import { formatDM, formatDMY, pluralizeRu } from '../lib/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const latestPosts = posts.slice(0, 3);

const postCount = posts.length;
const postWord = pluralizeRu(postCount, 'запись', 'записи', 'записей');
const newestPost = posts[0];
const summaryLine = newestPost
  ? `${postCount} ${postWord} · последняя ${formatDMY(newestPost.data.published)}`
  : `${postCount} ${postWord}`;

const COMMAND = 'ls -lt ~/blog | head -3';

// The homepage shows the two public projects plus the blog itself; the full
// list lives on /projects/.
const cards = [
  ...FEATURED_PROJECTS.map((project) => ({
    num: project.num,
    name: project.name,
    desc: project.desc,
    tags: project.tags.join(' · '),
    href: project.href ?? '/projects/',
    external: Boolean(project.external)
  })),
  {
    num: '03',
    name: 'Записки на полях',
    desc: 'Короткие тексты между большими проектами.',
    tags: 'тексты',
    href: '/blog/',
    external: false
  }
];

// Figlet "glepzilla" (STANDARD face) — server-rendered so the wordmark <h1>
// is correct with no JS. FRAMES comes from ../lib/wordmark, the single
// source of truth the client script below imports too, so the two can
// never drift apart.
const wordmarkInitial = FRAMES[0].join('\n');
---

<TerminalLayout>
  <div class="terminal-hero">
    <div class="hero-col">
      <h1 class="wordmark" aria-label="glepzilla"><span id="wordmark-art" aria-hidden="true">{wordmarkInitial}</span></h1>
    </div>

    <section class="tm-window" aria-label="Последние записи блога">
      <div class="tm-titlebar">
        <span class="tm-dot" aria-hidden="true"></span>
        <span class="tm-dot" aria-hidden="true"></span>
        <span class="tm-dot tm-dot--accent" aria-hidden="true"></span>
        <span class="tm-path">gleb@glepzilla — ~/blog</span>
      </div>
      <div class="tm-body card-body">
        <div class="tm-prompt"><span class="tm-prompt-sign">%</span> <span id="typed-cmd">{COMMAND}</span><span class="tm-cursor" aria-hidden="true"></span></div>
        <div class="tm-out ls-total">total {posts.length}</div>
        <div class="tm-ls">
          {latestPosts.map((post) => (
            <a class="tm-ls-row" href={`/blog/${post.id}/`}>
              <span class="tm-ls-date">{formatDM(post.data.published)}</span>
              <span class="tm-ls-name">{post.id}.md</span>
            </a>
          ))}
        </div>
        <div class="ls-summary">{summaryLine}</div>
      </div>
    </section>
  </div>

  <section class="tm-section terminal-projects" aria-label="Проекты">
    {cards.map((card) => (
      <a class="tm-project" href={card.href} rel={card.external ? 'noreferrer' : undefined}>
        <span class="tm-project-num">{card.num}</span>
        <span class="tm-project-name">{card.name}</span>
        <span class="tm-project-desc">{card.desc}</span>
        <span class="tm-project-tags">{card.tags}</span>
      </a>
    ))}
    <a class="all-projects tm-link" href="/projects/">% ls ~/projects — все проекты →</a>
  </section>
</TerminalLayout>

<script>
  // cycleWordmark is ported from the design file's behaviour comment
  // (design-2a-spec.html) as written; componentDidMount's typing is adapted
  // from the design tool's tiny component runtime to plain DOM/timer calls.
  // FRAMES/W/H/NOISE come from ../lib/wordmark, the single source of truth
  // the page's frontmatter imports too (for the SSR'd FRAMES[0]), so the two
  // can never drift.
  import { FRAMES, W, H, NOISE } from '../lib/wordmark';

  const COMMAND = 'ls -lt ~/blog | head -3';

  const timers: ReturnType<typeof setTimeout>[] = [];

  function type(el: Element, text: string, speed: number, delay = 0) {
    el.textContent = '';
    let i = 0;
    const step = () => {
      i += 1;
      el.textContent = text.slice(0, i);
      if (i < text.length) timers.push(setTimeout(step, speed + Math.random() * speed));
    };
    timers.push(setTimeout(step, 350 + delay));
  }

  /** Перебор символов: одно начертание рассыпается в шум и собирается следующим. */
  function cycleWordmark(el: Element) {
    const HOLD = 42; // тиков (×60ms) держим набранное слово
    const MORPH = 14; // тиков идёт перебор
    let idx = 0;
    let tick = 0;
    return setInterval(() => {
      tick += 1;
      if (tick <= HOLD) return;
      const step = tick - HOLD;
      const from = FRAMES[idx];
      const to = FRAMES[(idx + 1) % FRAMES.length];
      if (step > MORPH) {
        idx = (idx + 1) % FRAMES.length;
        tick = 0;
        el.textContent = FRAMES[idx].join('\n');
        return;
      }
      const p = step / MORPH;
      const rows = [];
      for (let r = 0; r < H; r += 1) {
        let line = '';
        for (let c = 0; c < W; c += 1) {
          const a = from[r][c];
          const b = to[r][c];
          if (a === ' ' && b === ' ') {
            line += ' ';
            continue;
          }
          if (Math.random() < p * p) line += b;
          else if (Math.random() < 0.55) line += NOISE[(Math.random() * NOISE.length) | 0];
          else line += a === ' ' ? b : a;
        }
        rows.push(line);
      }
      el.textContent = rows.join('\n');
    }, 60);
  }

  const typedEl = document.getElementById('typed-cmd');
  const wordmarkEl = document.getElementById('wordmark-art');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion) {
    if (typedEl) type(typedEl, COMMAND, 34, 900);
    if (wordmarkEl) cycleWordmark(wordmarkEl);
  }
</script>

<style>
  .terminal-hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 52px;
    align-items: center;
    padding: 76px var(--tm-pad-x) 68px;
  }
  .hero-col { display: flex; flex-direction: column; gap: 26px; min-width: 0; }
  .wordmark {
    margin: 0;
    overflow: hidden;
    color: var(--tm-green);
    font-family: var(--tm-font-ascii);
    font-size: clamp(11px, 1.85vw, 21px);
    font-weight: 400;
    line-height: 1.04;
    white-space: pre;
    text-shadow: 0 0 18px var(--tm-glow), 0 0 46px rgba(143, 187, 95, 0.18);
  }

  .card-body { min-height: 250px; }
  .ls-total { padding-top: 10px; }
  .ls-summary { padding-top: 12px; color: var(--tm-muted); }

  .terminal-projects {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding-bottom: 40px;
  }
  .all-projects {
    grid-column: 1 / -1;
    justify-self: start;
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .terminal-hero { grid-template-columns: 1fr; gap: 36px; }
    .terminal-projects { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 700px) {
    .terminal-hero { padding: 40px var(--tm-pad-x) 36px; }
    .terminal-projects { grid-template-columns: 1fr; padding-bottom: 28px; }
  }
</style>
